{
  "$defs": {
    "DerivationKind": {
      "description": "Source-independent category of canonical derivation.",
      "enum": [
        "direct_mapping",
        "normalization",
        "enrichment",
        "synthetic_test"
      ],
      "title": "DerivationKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Canonical derivation metadata, not a replacement for source observations.\n\nA SourceObservation describes captured source material. Provenance records how\ncanonical data was derived from one or more observations. EventEvidence links\nthose observations to a particular canonical event.",
  "properties": {
    "derivation_kind": {
      "$ref": "#/$defs/DerivationKind"
    },
    "derived_at": {
      "format": "date-time",
      "title": "Derived At",
      "type": "string"
    },
    "parent_provenance_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Parent Provenance Ids",
      "type": "array"
    },
    "provenance_id": {
      "format": "uuid",
      "title": "Provenance Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_observation_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Observation Ids",
      "type": "array"
    },
    "transform_version": {
      "minLength": 1,
      "title": "Transform Version",
      "type": "string"
    }
  },
  "required": [
    "provenance_id",
    "source_observation_ids",
    "derivation_kind",
    "derived_at",
    "transform_version"
  ],
  "title": "Provenance",
  "type": "object"
}
