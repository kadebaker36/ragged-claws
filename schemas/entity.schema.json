{
  "$defs": {
    "AliasType": {
      "enum": [
        "legal_name",
        "trade_name",
        "former_name",
        "source_reported",
        "other"
      ],
      "title": "AliasType",
      "type": "string"
    },
    "EntityAlias": {
      "additionalProperties": false,
      "description": "A source-backed alias claim; aliases never define canonical identity.",
      "properties": {
        "alias_type": {
          "$ref": "#/$defs/AliasType"
        },
        "entity_alias_id": {
          "format": "uuid",
          "title": "Entity Alias Id",
          "type": "string"
        },
        "entity_id": {
          "format": "uuid",
          "title": "Entity Id",
          "type": "string"
        },
        "known_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemporalValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "provenance_id": {
          "format": "uuid",
          "title": "Provenance Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_observation_id": {
          "format": "uuid",
          "title": "Source Observation Id",
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemporalValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "valid_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemporalValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "entity_alias_id",
        "entity_id",
        "value",
        "alias_type",
        "source_observation_id",
        "provenance_id",
        "observed_at"
      ],
      "title": "EntityAlias",
      "type": "object"
    },
    "EntityType": {
      "enum": [
        "person",
        "household",
        "issuer",
        "organization",
        "fund",
        "government_body",
        "nonprofit",
        "legal_entity"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "ExternalIdentifier": {
      "additionalProperties": false,
      "description": "A typed, source-backed identifier claim for a canonical subject.",
      "properties": {
        "external_identifier_id": {
          "format": "uuid",
          "title": "External Identifier Id",
          "type": "string"
        },
        "identifier_type": {
          "$ref": "#/$defs/ExternalIdentifierType"
        },
        "known_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemporalValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "market_scope": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Market Scope"
        },
        "namespace": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "provenance_id": {
          "format": "uuid",
          "title": "Provenance Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_observation_id": {
          "format": "uuid",
          "title": "Source Observation Id",
          "type": "string"
        },
        "subject_id": {
          "format": "uuid",
          "title": "Subject Id",
          "type": "string"
        },
        "subject_type": {
          "$ref": "#/$defs/IdentifierSubjectType"
        },
        "valid_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemporalValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "valid_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemporalValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "external_identifier_id",
        "subject_type",
        "subject_id",
        "identifier_type",
        "value",
        "source_observation_id",
        "provenance_id",
        "observed_at"
      ],
      "title": "ExternalIdentifier",
      "type": "object"
    },
    "ExternalIdentifierType": {
      "enum": [
        "sec_cik",
        "lei",
        "figi_instrument",
        "figi_share_class",
        "figi_composite",
        "isin",
        "cusip",
        "sedol",
        "other"
      ],
      "title": "ExternalIdentifierType",
      "type": "string"
    },
    "IdentifierSubjectType": {
      "enum": [
        "entity",
        "security",
        "listing"
      ],
      "title": "IdentifierSubjectType",
      "type": "string"
    },
    "PartialDate": {
      "additionalProperties": false,
      "description": "A date-like source value with only its defensible components populated.",
      "properties": {
        "day": {
          "anyOf": [
            {
              "maximum": 31,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Day"
        },
        "month": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Month"
        },
        "precision": {
          "$ref": "#/$defs/TemporalPrecision"
        },
        "raw_value": {
          "minLength": 1,
          "title": "Raw Value",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        }
      },
      "required": [
        "raw_value",
        "precision"
      ],
      "title": "PartialDate",
      "type": "object"
    },
    "TemporalPrecision": {
      "description": "Precision actually supported by the source value.",
      "enum": [
        "unknown",
        "year",
        "month",
        "day",
        "minute",
        "second"
      ],
      "title": "TemporalPrecision",
      "type": "string"
    },
    "TemporalValue": {
      "additionalProperties": false,
      "description": "A raw temporal value represented as a partial date or aware timestamp.",
      "properties": {
        "partial_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "precision": {
          "$ref": "#/$defs/TemporalPrecision"
        },
        "raw_value": {
          "minLength": 1,
          "title": "Raw Value",
          "type": "string"
        },
        "source_timezone": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Timezone"
        },
        "timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        }
      },
      "required": [
        "raw_value",
        "precision"
      ],
      "title": "TemporalValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Opaque canonical identity for a person, household, issuer, or organization.",
  "properties": {
    "aliases": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EntityAlias"
      },
      "title": "Aliases",
      "type": "array"
    },
    "display_name": {
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "entity_id": {
      "format": "uuid",
      "title": "Entity Id",
      "type": "string"
    },
    "entity_type": {
      "$ref": "#/$defs/EntityType"
    },
    "external_identifiers": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExternalIdentifier"
      },
      "title": "External Identifiers",
      "type": "array"
    },
    "provenance_id": {
      "format": "uuid",
      "title": "Provenance Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "entity_id",
    "entity_type",
    "display_name",
    "provenance_id"
  ],
  "title": "Entity",
  "type": "object"
}
