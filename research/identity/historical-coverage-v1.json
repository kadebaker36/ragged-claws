  "evidence_contract": {
    "id": "identity-and-coverage-v1",
    "security": "Sourced exact strong class identifier tied to correct issuer and class; permanent Security creation basis reviewed separately. CIK/name/title/symbol alone is insufficient.",
    "listing": "Instrument/venue FIGI with authenticated layer or separately reviewed permanent creation basis tied to Security; official source-backed venue text to operating/segment MIC mapping for applicable date. Do not use composite/exchCode as MIC.",
    "intervals": "Explicit half-open valid_from/valid_to bounds with source timing/precision; union covers entry through elapsed horizon exit inclusive, accounting for every class/venue/symbol change. Unknown endpoints remain unknown, never unbounded convenience.",
    "knowledge": "Preserve source known/public, valid/effective and observed/review clocks separately. Retrospective identity reconstruction is not evidence of collector possession or an allowable historical decision feature.",
    "transitions": "Retain predecessor/successor identity and effective dates from primary source. Same-Security renames need explicit listing_history; existing engine requires compatible MIC. Venue transfer or different-Security corporate action is not handled by silently concatenating bars.",
    "terminal": "Source-backed terminal event/date and terms before classifying delisted/merged; absent bars are missing/unknown, not terminal proof or invented0/-100%/last-price return. Maintain unresolved/censored/missing/terminal records.",
    "benchmark": "SPY is a requirement label only; independently resolve issuer/fund/class/Security/Listing, venue/MIC, dated interval and matching price convention. No symbol-created identity."
  },
